{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/registro", "destination": "/" },
    { "source": "/confirmar-correo", "destination": "/" },
    { "source": "/recuperar-contrasena", "destination": "/" },
    { "source": "/descripcion/cfdi", "destination": "/" },
    { "source": "/descripcion/asistente", "destination": "/" },
    { "source": "/descripcion/anam", "destination": "/" },
    { "source": "/descripcion/curso", "destination": "/" }
  ],
  "functions": {
    "api/tutor/stream.js": {
      "maxDuration": 30
    },
    "api/tutor/anam-session.js": {
      "maxDuration": 15
    },
    "api/cfdi/config.js": {
      "maxDuration": 5
    },
    "api/auth/index.js": {
      "maxDuration": 10
    }
  }
}
