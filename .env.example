# Copia a .env para desarrollo local o define estas variables como secretos en Vercel.
# Crea dos claves API de Vercel AI Gateway, ambas dedicadas a ContaIA.
# Asigna a cada clave su propio presupuesto mensual; nunca pegues los valores reales aquí.
AI_PROVIDER_DEFAULT=openai
AI_GATEWAY_OPENAI_API_KEY=
AI_GATEWAY_OPENAI_MODEL=openai/<modelo-del-catalogo>
AI_GATEWAY_ANTHROPIC_API_KEY=
AI_GATEWAY_ANTHROPIC_MODEL=anthropic/<modelo-del-catalogo>

# IA E5: JSON privado de aprobación exacta por proveedor/modelo.
# Debe usar ai-model-approval-v1; vacío o inválido bloquea las llamadas remotas de forma segura.
# No incluyas claves, prompts, cuentas, correos ni datos fiscales en esta variable.
AI_MODEL_APPROVALS_JSON=

# Orígenes exactos para permitir la llamada desde una página publicada por separado.
# En Vercel, si la página y las funciones comparten dominio, deja vacío.
TUTOR_ALLOWED_ORIGINS=

# Anam: define estos valores solo en variables privadas del servidor (p. ej. Vercel).
# Nunca uses prefijos VITE_, NEXT_PUBLIC_ o similares ni guardes valores reales aquí.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# Supabase: solo URL de proyecto y clave publicable; nunca uses service_role en el navegador.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# IA E2: lista privada, separada por comas, de IDs opacos de Supabase Auth con acceso Premium.
# Déjala vacía para que todas las cuentas usen Free. No uses RFC, correo ni identificadores fiscales.
# Esta allowlist es temporal: una suscripción real requerirá un resolver de entitlements versionado.
AI_PREMIUM_ACCOUNT_IDS=

# IA E3: store Redis REST compatible para cuotas distribuidas y leases.
# Configura ambos valores como secretos privados de Vercel; si faltan, desarrollo/pruebas usan memoria.
AI_RATE_LIMIT_KV_REST_URL=
AI_RATE_LIMIT_KV_REST_TOKEN=
# Opcionales: timeout del store, timeout de Gateway, umbral y recuperación del circuit breaker.
AI_RATE_LIMIT_KV_TIMEOUT_MS=2000
AI_GATEWAY_TIMEOUT_MS=15000
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=30000
