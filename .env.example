# Copia a .env para desarrollo local o define estas variables como secretos en Vercel.
# Crea dos claves API de Vercel AI Gateway, ambas dedicadas a ContaIA.
# Asigna a cada clave su propio presupuesto mensual; nunca pegues los valores reales aquí.
AI_PROVIDER_DEFAULT=openai
AI_GATEWAY_OPENAI_API_KEY=
AI_GATEWAY_OPENAI_MODEL=openai/<modelo-del-catalogo>
AI_GATEWAY_ANTHROPIC_API_KEY=
AI_GATEWAY_ANTHROPIC_MODEL=anthropic/<modelo-del-catalogo>

# Orígenes exactos para permitir la llamada desde una página publicada por separado.
# En Vercel, si la página y las funciones comparten dominio, deja vacío.
TUTOR_ALLOWED_ORIGINS=

# Anam: define estos valores solo en variables privadas del servidor (p. ej. Vercel).
# Nunca uses prefijos VITE_, NEXT_PUBLIC_ o similares ni guardes valores reales aquí.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
